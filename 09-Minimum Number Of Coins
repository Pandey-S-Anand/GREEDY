class Solution {
    /**
    * ✅ Why Greedy Works for Indian Currency Denominations
    *
    * Denominations: {1, 2, 5, 10, 20, 50, 100, 200, 500, 2000}
    *
    * ✅ Key Property:
    * Every larger denomination can be exactly broken down using smaller ones.
    * - 2 = 1 + 1
    * - 5 = 2 + 2 + 1
    * - 10 = 5 + 5
    * - 20 = 10 + 10
    * - 50 = 10 x 5
    * - 100 = 50 x 2
    * - 200 = 100 x 2
    * - 500 = 100 x 5
    * - 2000 = 500 x 4
    *
    * ✅ Why Greedy Works:
    * - Always picking the largest denomination that fits reduces the amount fastest.
    * - Since all larger denominations can be formed using smaller ones,
    *   we are never missing a better combination.
    * - So greedy guarantees the **minimum number of coins/notes**.
    *
    * ❌ When Greedy Fails (Not in our case):
    * Example with non-structured denominations: {1, 3, 4}, target = 6
    * - Greedy: 4 + 1 + 1 = 3 coins
    * - Optimal: 3 + 3 = 2 coins → Greedy fails
    *
    * ✅ But for Indian currency, greedy is always optimal due to structured denominations.
    */

    public List<Integer> minPartition(int N) {
        // Step 1: Define denominations in descending order
        int[] denominations = { 2000, 500, 200, 100, 50, 20, 10, 5, 2, 1 };

        List<Integer> coins = new ArrayList<>();

        // Step 2: Use greedy method — always choose largest denomination that fits into N
        for (int denomination : denominations) {
            // Count how many times this denomination fits
            while (N >= denomination) {
                N -= denomination;
                coins.add(denomination);
            }

            // If N becomes 0, we can break early
            if (N == 0) {
                break;
            }
        }

        return coins;
    }
}
