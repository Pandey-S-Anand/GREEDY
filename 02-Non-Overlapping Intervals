class Solution {
    public int eraseOverlapIntervals(int[][] intervals) {
        /*
         Given two intervals [a, b] and [c, d] with a < b and c < d,
         and considering intervals that only touch at a point as non-overlapping,
         the condition for these intervals to overlap is:
         a < d and b > c
        
         After sorting the intervals by their start time:
         For any two intervals [a, b] and [c, d] such that a < c,
         we automatically get a < d, so to check for overlap we just need to verify if b > c
        */
        /*
        Dry Run with input: [[1,5],[2,3],[4,8],[5,9],[7,11]]
        
        Step 1: Sort intervals by start time
        Sorted intervals: [[1,5], [2,3], [4,8], [5,9], [7,11]]
        
        Initialize:
        previous = 0  → interval [1,5]
        intervalsToRemove = 0
        
        current = 1 → interval [2,3]
        → overlaps with [1,5] since 5 > 2 → overlap detected
        → choose [2,3] (smaller end time), so remove [1,5]
        → update previous = 1
        → intervalsToRemove = 1
        
        current = 2 → interval [4,8]
        → no overlap with [2,3] since 3 <= 4 → no overlap
        → update previous = 2
        
        current = 3 → interval [5,9]
        → overlaps with [4,8] since 8 > 5 → overlap detected
        → choose [4,8] (smaller end time), so remove [5,9]
        → previous remains = 2
        → intervalsToRemove = 2
        
        current = 4 → interval [7,11]
        → overlaps with [4,8] since 8 > 7 → overlap detected
        → choose [4,8] (end=8) over [7,11] (end=11)
        → remove [7,11]
        → previous remains = 2
        → intervalsToRemove = 3
        
        Final: intervalsToRemove = 3
        */

        // Step 1: Sort intervals based on start time
        Arrays.sort(intervals, (a, b) -> Integer.compare(a[0], b[0]));

        int previous = 0; // Pointer to the last non-overlapping interval
        int intervalsToRemove = 0; // Count of intervals to remove

        // Step 2: Traverse from the second interval onward
        for (int current = 1; current < intervals.length; current++) {

            // Case 1: No overlap (previous ends before or exactly at current's start)
            if (intervals[previous][1] <= intervals[current][0]) {
                previous = current; // Move the window (or i++)
            } else {
                // Case 2: Overlap detected → must remove one interval
                intervalsToRemove++;

                // Subcase: previous interval has higher end time
                if (intervals[previous][1] > intervals[current][1]) {
                    // Skip the previous interval as it has a higher end time, which makes it more likely to overlap with future intervals 
                    previous = current; // or i++
                }
                /*
                 Subcase: current interval has higher end time
                 Keep previous interval and move to the next interval (i.e current++)
                 as it has a higher end time, which makes it more likely to overlap with future intervals
                */
            }
        }

        // Step 3: Return total number of intervals removed
        return intervalsToRemove;
    }
}

