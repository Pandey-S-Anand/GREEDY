class Solution {
    static boolean canAttend(int[][] intervals) {
        // Sort the intervals by their start times : This ensures meetings are checked in the order they would happen
        Arrays.sort(intervals, (interval1, interval2) -> Integer.compare(interval1[0], interval2[0]));

        //Track the previous interval to compare with the current one
        int[] previousInterval = intervals[0];

        //Traverse the sorted intervals to check for overlaps
        for (int i = 1; i < intervals.length; i++) {
            int[] currentInterval = intervals[i];

            /*
             If the start time of the current meeting is less than
             the end time of the previous meeting, there's an overlap,
             meaning the person cannot attend both meetings.
            */
            if (previousInterval[1] > currentInterval[0]) {
                return false;
            }

            // Update previousInterval for next comparison
            previousInterval = currentInterval;
        }

        // No overlapping meetings found — all can be attended
        return true;
    }
}
